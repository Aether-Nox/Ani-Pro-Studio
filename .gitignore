# 1. Ignore all source code and development folders
src/
assembly/
test/

# 2. Ignore configuration and project management files
package.json
package-lock.json
webpack.config.cjs
asconfig.json

# 3. Ignore Node dependencies
node_modules/

# 4. Ignore private keys (CRITICAL - never share this)
*.pem

# 5. Handle WebAssembly (build folder)
# Ignore everything in the build folder...
build/*
# ...but explicitly allow the compiled release files needed to run the extension
!build/release.wasm
!build/release.js

# 6. Ignore the CRX file in the repo (Distribute this via GitHub Releases instead)
*.crx

# OS generated files
.DS_Store
Thumbs.db